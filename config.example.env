# Copy to config.env and fill in.
# Token: @BotFather → /newbot
TG_BOT_TOKEN=

# Destination group. python bridge.py --discover
TG_CHAT_ID=

# Forum topic name as shown in Telegram. --discover writes the id.
TG_TOPIC=
TG_THREAD_ID=

# Viber chat name (substring match against the Desktop chat list).
VIBER_GROUP=

# Key for the local viber.db:
#   1) start Viber Desktop
#   2) python bridge.py --setup-key
VIBER_HEXKEY=

POLL_SEC=1
